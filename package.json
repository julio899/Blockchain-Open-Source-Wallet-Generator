{
  "name": "blockchain-open-source-wallet-generator",
  "version": "2.0.0",
  "description": "Generador de wallets Ethereum offline: CSPRNG nativo, BIP-39/BIP-44 y keystore V3 endurecido",
  "type": "module",
  "main": "src/cli/01-generar-wallet.js",
  "scripts": {
    "start": "node src/cli/01-generar-wallet.js",
    "build": "node src/cli/02-generar-wallet-con-encryptado.js",
    "desencriptar": "node src/cli/03-deserealizar-wallet-encrypt.js",
    "recifrar": "node src/cli/04-recifrar-keystore.js",
    "build:web": "node scripts/build-web.js",
    "test": "node --test \"test/**/*.test.js\"",
    "audit": "npm audit --omit=dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julio899/Blockchain-Open-Source-Wallet-Generator.git"
  },
  "keywords": [
    "blockchain",
    "security",
    "web3",
    "wallet",
    "bip39",
    "bip44"
  ],
  "author": "Julio Vinachi @julio899 <julio899@gmail.com>",
  "license": "GPLv3",
  "engines": {
    "node": ">=20.19"
  },
  "bugs": {
    "url": "https://github.com/julio899/Blockchain-Open-Source-Wallet-Generator/issues"
  },
  "homepage": "https://github.com/julio899/Blockchain-Open-Source-Wallet-Generator#readme",
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
